[core]
  excludesFile = ~/.gitignore

[init]
  defaultBranch = main

[pull]
  rebase = true

[rebase]
  autostash = true

[fetch]
  prune = true

[push]
  # Push to the same-named branch on the remote, never to whatever the local
  # branch happens to track. With `upstream`, a branch created from origin/main
  # tracked main, so `git push` from it wrote to main. That has happened more
  # than once; `current` makes the branch name the only thing that picks the
  # destination.
  #
  # These push settings, and the pre-push hook under core.hooksPath, exist
  # explicitly so that LLM coding agents running git on this machine cannot
  # accidentally push to main or force-push. Agents inherit this config and
  # these hooks like any other process, and an agent working in a worktree
  # branched from origin/main is exactly how the last incident happened.
  default = current
  autoSetupRemote = true
  # Make --force-with-lease also refuse when the remote moved since we last
  # fetched it, closing the window a background fetch would otherwise open.
  useForceIfIncludes = true

[branch]
  # Track only when the local and remote names match. `git checkout -b x
  # origin/main` and `git worktree add -b x origin/main` no longer make x track
  # main, but `git checkout x` from an existing origin/x still tracks it, so
  # `git pull` on checked-out branches keeps working. (`false` broke that.)
  autoSetupMerge = simple

[core]
  # Global hooks. git/hooks/pre-push refuses pushes to main and force pushes
  # unless explicitly opted in, and chains to any repo-local hook afterwards.
  # The opt-ins are environment variables a human sets on one command, so an
  # LLM agent cannot satisfy them by constructing a different git invocation.
  # Exemptions, so the guard does not become daily friction: personal repos
  # (remote owned by dwwhitlock, or `hooks.protectedPushOk = true` set locally)
  # may push to main, and force pushes to refs/heads/dwightwhitlock/* branches
  # need no opt-in. Force pushes to main always do.
  hooksPath = ~/.config/git/hooks

[user]
  email = 59847742+dwwhitlock@users.noreply.github.com
  name = Dwight Whitlock
	signingkey = C8682424579A5DC5

[alias]
  co = checkout
  br = branch 
  ci = commit
  st = status
  aa = add --all
  # Explicit, lease-guarded force push. The bare `p = push` alias is gone on
  # purpose: one keystroke to publish is how mistakes ship.
  pushf = push --force-with-lease --force-if-includes
  reset-main = "!git checkout main && git reset --hard origin/main"
  cleanup-branches = "!git branch -vv | grep ': gone]' | awk '{print $1}' | xargs -r git branch -d"



[url "git@github.com:"]
  insteadOf = https://github.com/


[commit]
        gpgsign = true
[tag]
        gpgSign = true
[gpg]
        program = /opt/homebrew/bin/gpg
