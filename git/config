[core]
  excludesFile = ~/.gitignore

[init]
  defaultBranch = main

[pull]
  rebase = true

[rebase]
  autostash = true

[fetch]
  prune = true

[push]
  # Push to the same-named branch on the remote, never to whatever the local
  # branch tracks. Under `upstream`, a branch created from origin/main tracked
  # main, so a bare `git push` from it wrote to main.
  default = current
  autoSetupRemote = true
  # --force-with-lease also refuses if the remote moved since our last fetch.
  useForceIfIncludes = true

[branch]
  # Track only when local and remote names match, so `checkout -b x origin/main`
  # no longer makes x track main.
  autoSetupMerge = simple

[user]
  email = 59847742+dwwhitlock@users.noreply.github.com
