#!/usr/bin/env sh
# Global pre-push guard, installed via core.hooksPath (see git/config).
# Tests: git/hooks/test_pre_push (run it after any change here or in git/config).
#
# Refuses, in order:
#   1. deleting a protected branch (main/master)     -> always
#   2. pushing to a protected branch                 -> unless the repo is personal
#                                                       or ALLOW_PROTECTED_PUSH=1
#   3. a non-fast-forward (force) push               -> to a protected branch: unless ALLOW_FORCE_PUSH=1
#                                                       to refs/heads/dwightwhitlock/*: allowed
#                                                       elsewhere: unless ALLOW_FORCE_PUSH=1
# then hands off to _chain, which runs the pre-commit framework and/or the
# repository's own pre-push hook with the ref list replayed on stdin.
#
# "Personal" means the push URL is owned by dwwhitlock on GitHub, or the repo
# has `git config hooks.protectedPushOk true` set locally. Direct pushes to
# main are normal there; the guard is for shared repositories.
#
# The opt-ins are environment variables on purpose: they cannot be set by
# accident, and they leave a trace in shell history.
#   ALLOW_PROTECTED_PUSH=1 git push origin main
#   ALLOW_FORCE_PUSH=1     git pushf
#
# This hook exists explicitly so that LLM coding agents running git on this
# machine cannot accidentally push to main or force-push. Agents run under the
# same core.hooksPath as everything else and cannot opt in without a human
# putting the variable on the command line.

remote="$1"
url="$2"
protected='^refs/heads/(main|master)$'
own_prefix='^refs/heads/dwightwhitlock/'
personal_owner='github\.com[:/]dwwhitlock/'
zero=0000000000000000000000000000000000000000
status=0

personal=0
if echo "$url" | grep -Eq "$personal_owner"; then personal=1; fi
if [ "$(git config --bool --get hooks.protectedPushOk 2>/dev/null)" = "true" ]; then personal=1; fi

refs="$(mktemp)"
trap 'rm -f "$refs"' EXIT
cat > "$refs"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue

  is_protected=0
  if echo "$remote_ref" | grep -Eq "$protected"; then is_protected=1; fi

  if [ "$local_sha" = "$zero" ] && [ "$is_protected" = 1 ]; then
    echo "pre-push: refusing to delete protected branch $remote_ref on $remote" >&2
    status=1
    continue
  fi

  if [ "$is_protected" = 1 ] && [ "$personal" != 1 ] && [ "${ALLOW_PROTECTED_PUSH:-0}" != "1" ]; then
    echo "pre-push: refusing to push $local_ref -> $remote_ref on $remote." >&2
    echo "          Open a pull request. One-time override: ALLOW_PROTECTED_PUSH=1 git push ..." >&2
    echo "          Personal repo? git config hooks.protectedPushOk true" >&2
    status=1
    continue
  fi

  if [ "$remote_sha" != "$zero" ] && [ "$local_sha" != "$zero" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      # Own feature branches may be rewritten freely; everything else needs the opt-in,
      # and main always does even in a personal repo.
      if echo "$remote_ref" | grep -Eq "$own_prefix" && [ "$is_protected" != 1 ]; then
        :
      elif [ "${ALLOW_FORCE_PUSH:-0}" != "1" ]; then
        echo "pre-push: $remote_ref on $remote is not an ancestor of $local_ref (this is a force push)." >&2
        echo "          One-time override: ALLOW_FORCE_PUSH=1 git pushf" >&2
        status=1
        continue
      fi
    fi
  fi
done < "$refs"

[ "$status" -ne 0 ] && exit "$status"

# Hand off to the shared dispatcher: pre-commit framework (if the repo has a
# config naming the pre-push stage) and/or the repo-local .git/hooks/pre-push,
# with the ref list replayed on stdin. See _chain for why --git-path is not
# used to find the repo-local hook.
exec "$(dirname "$0")/_chain" pre-push "$@" < "$refs"
