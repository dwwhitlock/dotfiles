{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/Library/Application Support/zoxide"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/code/dotfiles/bin/standup-session-summary\""
          }
        ]
      }
    ]
  }
}
