# ~/.zshrc -> ~/code/dotfiles/.zshrc
#
# Key bindings and shortcuts are documented in HOTKEYS.md. Update it when
# changing bindkeys, setopts, plugins or the fzf/zoxide setup.

# ── Environment ──────────────────────────────────────────────────────────────
export LANG=en_US.UTF-8
export EDITOR=nvim
export DOTFILES_ROOT="$HOME/code/dotfiles"
export WORK_DOTFILES_ROOT="$HOME/code/work-dotfiles"   # private employer repo; optional
export PYENV_ROOT="$HOME/.pyenv"

# Homebrew: Apple silicon or Linux (brew shellenv may already have set this)
if [[ -z $HOMEBREW_PREFIX ]]; then
  for HOMEBREW_PREFIX in /opt/homebrew /home/linuxbrew/.linuxbrew; do
    [[ -d $HOMEBREW_PREFIX ]] && break
  done
fi
export HOMEBREW_PREFIX
export JAVA_HOME="$HOMEBREW_PREFIX/opt/openjdk@17"  # Java 17, required for PySpark 4.x

# ── PATH and fpath ───────────────────────────────────────────────────────────
# Highest priority first. -U drops duplicates; (N-/) drops dirs that don't exist.
typeset -U path PATH fpath
path=(
  $HOME/.bun/bin              # bun add -g
  $JAVA_HOME/bin
  $HOME/.rd/bin               # Rancher Desktop (its PATH Configuration is set to Manual)
  $HOME/.local/bin            # Claude Code
  $WORK_DOTFILES_ROOT/bin
  $DOTFILES_ROOT/bin
  $PYENV_ROOT/shims
  $HOMEBREW_PREFIX/bin
  $HOMEBREW_PREFIX/sbin
  $path
)
path=($^path(N-/))
fpath=($HOMEBREW_PREFIX/share/zsh/site-functions $fpath)

# ── History ──────────────────────────────────────────────────────────────────
HISTFILE=$HOME/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS EXTENDED_HISTORY

# ── Shell options ────────────────────────────────────────────────────────────
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS   # navigation
setopt CORRECT                                # offer to fix mistyped commands

# ── Completion ───────────────────────────────────────────────────────────────
# Full rebuild at most once a day; otherwise load the cached dump.
autoload -Uz compinit
_zcompdump=${ZDOTDIR:-$HOME}/.zcompdump
_stale=($_zcompdump(N.mh+24))   # a plain glob here doesn't need extendedglob
if (( $#_stale )) || [[ ! -e $_zcompdump ]]; then
  compinit && touch $_zcompdump  # touch so the 24h timer resets
else
  compinit -C
fi
unset _zcompdump _stale

zstyle ':completion:*' menu select                        # arrow-key menu
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'    # case-insensitive

# ── Key bindings (see HOTKEYS.md) ────────────────────────────────────────────
bindkey -e   # explicit: EDITOR=nvim would otherwise silently select vi mode

# Up/Down: search history for commands starting with what's already typed
bindkey '^[[A' history-beginning-search-backward
bindkey '^[[B' history-beginning-search-forward

# Ctrl-X Ctrl-E: edit the current command in $EDITOR
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# Ctrl-W stops at / so it deletes one path segment
WORDCHARS=${WORDCHARS//\/}

# ── Aliases and private config ───────────────────────────────────────────────
source $DOTFILES_ROOT/.aliases
[[ -f $WORK_DOTFILES_ROOT/.work_shellrc ]] && source $WORK_DOTFILES_ROOT/.work_shellrc  # also loads ~/.work_shellrc.local

# ── Tool hooks ───────────────────────────────────────────────────────────────
# Each tool's init script is cached in ~/.cache/zsh-init instead of being
# regenerated by a subprocess on every shell start. The cache is rebuilt when
# the tool's resolved binary path changes, which happens on every brew upgrade.
_cached_init() {
  local name=$1; shift
  local bin=${commands[$name]:A}
  [[ -n $bin ]] || return 0
  local cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh-init/$name.zsh first
  [[ -r $cache ]] && read -r first < $cache
  if [[ $first != "# $bin" ]]; then
    mkdir -p ${cache:h}
    { print -r -- "# $bin"; "$@" } > $cache
  fi
  source $cache
}
_cached_init direnv   direnv hook zsh
_cached_init fzf      fzf --zsh                            # Ctrl-R / Ctrl-T / Alt-C; after bindkey -e
_cached_init starship starship init zsh --print-full-init
_cached_init zoxide   zoxide init zsh                      # keep after other chpwd hooks
unfunction _cached_init

# ── Plugins (syntax-highlighting must be last) ───────────────────────────────
source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
