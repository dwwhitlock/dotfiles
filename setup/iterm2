#!/usr/bin/env sh
# Install the iTerm2 Dynamic Profile from iterm2/ and make it the default.
# Run with iTerm2 QUIT (e.g. from Terminal.app): iTerm2 overwrites its
# preferences on exit, which would undo the default-profile change below.
#
# The profile only sets what this repo needs (see iterm2/dotfiles.json);
# everything else is iTerm2's default.

set -eu

PROJECT_ROOT=$(git rev-parse --show-toplevel)
PROFILE_GUID="A9DAAEFF-2F7C-4B54-B31B-1CDEE07583D2"  # must match iterm2/dotfiles.json
DYNAMIC_DIR="$HOME/Library/Application Support/iTerm2/DynamicProfiles"

if pgrep -xq iTerm2; then
  echo "setup/iterm2: quit iTerm2 first, then re-run this from another terminal." >&2
  exit 1
fi

mkdir -p "$DYNAMIC_DIR"
ln -sf "$PROJECT_ROOT/iterm2/dotfiles.json" "$DYNAMIC_DIR/dotfiles.json"

defaults write com.googlecode.iterm2 "Default Bookmark Guid" -string "$PROFILE_GUID"

echo "setup/iterm2: profile linked and set as default. Start iTerm2."
