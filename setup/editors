#!/usr/bin/env python3
"""Check or apply this repo's editor settings to each editor's own settings file.

The desired settings live in editors/*.json. Only the keys listed there are
checked or changed; everything else in the editor's file, including comments,
is left exactly as it is. Editors keep owning their files, so nothing here
creates repo diffs (see "No diffs from normal use" in CLAUDE.md).

    setup/editors           report what differs; writes nothing; exit 1 if anything differs
    setup/editors --apply   back up each file that differs, then fix only those keys

Backups go to ~/.cache/dotfiles/editor-backups/.
"""

import json
import shutil
import subprocess
import sys
import time
import xml.etree.ElementTree as ET
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DESIRED = ROOT / "editors"
HOME = Path.home()
MAC = sys.platform == "darwin"
BACKUPS = HOME / ".cache/dotfiles/editor-backups"
STAMP = time.strftime("%Y%m%d-%H%M%S")


# ── JSON with comments (VS Code and Zed settings) ────────────────────────────
# A small parser that also records where each value sits in the text, so values
# can be replaced or keys inserted without rewriting (and losing) the rest.


class JSONC:
    def __init__(self, text):
        self.t, self.i = text, 0

    def skip(self):
        t = self.t
        while self.i < len(t):
            if t[self.i] in " \t\r\n":
                self.i += 1
            elif t.startswith("//", self.i):
                end = t.find("\n", self.i)
                self.i = len(t) if end < 0 else end
            elif t.startswith("/*", self.i):
                end = t.find("*/", self.i + 2)
                if end < 0:
                    raise ValueError("unterminated /* comment")
                self.i = end + 2
            else:
                return

    def expect(self, ch):
        self.skip()
        if self.t[self.i : self.i + 1] != ch:
            raise ValueError(f"expected {ch!r} at offset {self.i}")
        self.i += 1

    def string(self):
        j = self.i + 1
        while self.t[j] != '"':
            j += 2 if self.t[j] == "\\" else 1
        s = json.loads(self.t[self.i : j + 1])
        self.i = j + 1
        return s

    def value(self):
        self.skip()
        start, c = self.i, self.t[self.i : self.i + 1]
        if c == "{":
            return self.obj()
        if c == "[":
            self.i += 1
            items = []
            while True:
                self.skip()
                if self.t[self.i] == "]":
                    self.i += 1
                    break
                items.append(self.value()["value"])
                self.skip()
                if self.t[self.i] == ",":
                    self.i += 1
            return {"start": start, "end": self.i, "value": items}
        if c == '"':
            s = self.string()
            return {"start": start, "end": self.i, "value": s}
        end = self.i
        while end < len(self.t) and self.t[end] not in ",]}/ \t\r\n":
            end += 1
        literal, self.i = self.t[self.i : end], end
        return {"start": start, "end": end, "value": json.loads(literal)}

    def obj(self):
        start = self.i
        self.i += 1
        members = {}
        while True:
            self.skip()
            if self.t[self.i] == "}":
                self.i += 1
                break
            key_start = self.i
            key = self.string()
            self.expect(":")
            members[key] = self.value() | {"key_start": key_start}
            self.skip()
            if self.t[self.i] == ",":
                self.i += 1
        return {
            "start": start,
            "end": self.i,
            "members": members,
            "value": {k: v["value"] for k, v in members.items()},
        }


def line_indent(text, pos):
    line_start = text.rfind("\n", 0, pos) + 1
    j = line_start
    while j < len(text) and text[j] in " \t":
        j += 1
    return text[line_start:j]


def plan_jsonc(text, want):
    """Return (differences, new_text) for the keys in `want`."""
    try:
        root = JSONC(text).value()
    except (ValueError, IndexError) as e:
        raise ValueError(f"can't parse settings file: {e}") from None
    if "members" not in root:
        raise ValueError("settings file's top level isn't an object")

    diffs, replacements, inserts = [], [], {}

    def walk(node, want, path):
        for key, val in want.items():
            have = node["members"].get(key)
            label = ".".join(path + [key])
            if isinstance(val, dict) and have is not None and "members" in have:
                walk(have, val, path + [key])
            elif have is None:
                diffs.append(f"missing  {label} = {json.dumps(val)}")
                inserts.setdefault(node["start"], (node, []))[1].append((key, val))
            elif have["value"] != val:
                diffs.append(f"differs  {label}: {json.dumps(have['value'])} -> {json.dumps(val)}")
                replacements.append((have["start"], have["end"], json.dumps(val)))

    walk(root, want, [])

    edits = list(replacements)
    for node, entries in inserts.values():
        members = node["members"]
        if members:
            first = min(m["key_start"] for m in members.values())
            indent = line_indent(text, first)
        else:
            indent = line_indent(text, node["start"]) + "  "
        body = f",\n{indent}".join(f"{json.dumps(k)}: {json.dumps(v)}" for k, v in entries)
        tail = "," if members else "\n" + line_indent(text, node["start"])
        pos = node["start"] + 1
        edits.append((pos, pos, f"\n{indent}{body}{tail}"))

    for start, end, new in sorted(edits, key=lambda e: e[0], reverse=True):
        text = text[:start] + new + text[end:]
    return diffs, text


# ── JetBrains XML (PyCharm) ──────────────────────────────────────────────────
# Files look like <application><component name=X><option name=Y value=Z/>...


def plan_xml(text, want):
    """`want` is {component: {option: value}}. Return (differences, new_text)."""
    root = ET.fromstring(text) if text.strip() else ET.Element("application")
    diffs = []
    for comp_name, options in want.items():
        comp = root.find(f"component[@name='{comp_name}']")
        if comp is None:
            comp = ET.SubElement(root, "component", name=comp_name)
        for opt_name, val in options.items():
            opt = comp.find(f"option[@name='{opt_name}']")
            have = None if opt is None else opt.get("value")
            if have == val:
                continue
            label = f"{comp_name}.{opt_name}"
            diffs.append(f"missing  {label} = {val}" if have is None else f"differs  {label}: {have} -> {val}")
            if opt is None:
                opt = ET.SubElement(comp, "option", name=opt_name)
            opt.set("value", val)
    ET.indent(root, space="  ")
    return diffs, ET.tostring(root, encoding="unicode") + "\n"


# ── Editors ──────────────────────────────────────────────────────────────────


def newest_pycharm():
    base = HOME / ("Library/Application Support/JetBrains" if MAC else ".config/JetBrains")

    def version(d):
        try:
            return tuple(int(x) for x in d.name.removeprefix("PyCharm").split("."))
        except ValueError:
            return ()

    dirs = [d for d in base.glob("PyCharm*") if (d / "options").is_dir()]
    return max(dirs, key=version, default=None)


def is_running(pattern):
    """True if running, or if we can't tell (pgrep exits 1 only for a clean "no match")."""
    try:
        return subprocess.run(["pgrep", "-f", pattern], capture_output=True).returncode != 1
    except OSError:
        return True


def targets():
    """Yield (editor, settings file, desired, planner, app-running pattern or None)."""
    code_dir = HOME / ("Library/Application Support/Code/User" if MAC else ".config/Code/User")
    yield "VS Code", code_dir / "settings.json", load("vscode.json"), plan_jsonc, None
    yield "Zed", HOME / ".config/zed/settings.json", load("zed.json"), plan_jsonc, None

    pycharm = newest_pycharm()
    for rel, want in load("pycharm.json").items():
        path = pycharm / rel if pycharm else HOME / "PyCharm-not-installed" / rel
        # PyCharm rewrites these files on exit, so only edit them while it's closed.
        yield "PyCharm", path, want, plan_xml, "PyCharm.app|pycharm"


def load(name):
    return json.loads((DESIRED / name).read_text())


def main():
    apply = "--apply" in sys.argv[1:]
    unresolved = 0  # files still not matching editors/ when we finish

    for editor, path, want, planner, running_pattern in targets():
        print(f"{editor}: {path.relative_to(HOME) if path.is_relative_to(HOME) else path}")
        if not path.parent.is_dir():
            print("  skip     not installed\n")
            continue

        try:
            if path.exists():
                text = path.read_text()
            else:
                text = "{}\n" if planner is plan_jsonc else ""
            diffs, new_text = planner(text, want)
        except (ValueError, ET.ParseError) as e:
            print(f"  error    {e}\n")
            unresolved += 1
            continue

        if not diffs:
            print("  ok\n")
            continue
        for d in diffs:
            print(f"  {d}")

        if not apply:
            unresolved += 1
        else:
            if running_pattern and is_running(running_pattern):
                print(f"  not applied: {editor} is running (or its state can't be checked);")
                print(f"               quit it first, it overwrites this file on exit\n")
                unresolved += 1
                continue
            if path.exists():
                backup = BACKUPS / editor.replace(" ", "") / f"{path.name}.{STAMP}"
                backup.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(path, backup)
                print(f"  backup   {backup}")
            path.write_text(new_text)
            print("  applied")
        print()

    if unresolved and not apply:
        print("Run setup/editors --apply to fix the differences above.")
    return 1 if unresolved else 0


if __name__ == "__main__":
    sys.exit(main())
