#!/usr/bin/env sh

PROJECT_ROOT=$(git rev-parse --show-toplevel)

# git
ln -sf $PROJECT_ROOT/git/config ~/.gitconfig
ln -sf $PROJECT_ROOT/git/ignore ~/.gitignore

# shell
ln -sf $PROJECT_ROOT/.zshrc ~/.zshrc
ln -sf $PROJECT_ROOT/.aliases ~/.aliases
ln -sf $PROJECT_ROOT/.secrets ~/.secrets

# repo index + status script, used from ~/code
ln -sfn $PROJECT_ROOT/code/CLAUDE.md ~/code/CLAUDE.md
ln -sfn $PROJECT_ROOT/code/status.sh ~/code/status.sh

