#!/usr/bin/env sh

PROJECT_ROOT=$(git rev-parse --show-toplevel)

# git
ln -sf $PROJECT_ROOT/git/config ~/.gitconfig
ln -sf $PROJECT_ROOT/git/ignore ~/.gitignore

# shell
ln -sf $PROJECT_ROOT/.zshrc ~/.zshrc

# prompt
mkdir -p ~/.config
ln -sf $PROJECT_ROOT/starship/starship.toml ~/.config/starship.toml

