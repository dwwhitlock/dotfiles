#!/usr/bin/env sh
# Safe to re-run: each step checks before changing anything.

# gpg
GPG_AGENT_CONF="$HOME/.gnupg/gpg-agent.conf"
PINENTRY_LINE="pinentry-program /opt/homebrew/bin/pinentry-mac"

mkdir -p "$HOME/.gnupg"
chmod 700 "$HOME/.gnupg"
if ! grep -qxF "$PINENTRY_LINE" "$GPG_AGENT_CONF" 2>/dev/null; then
  echo "$PINENTRY_LINE" >> "$GPG_AGENT_CONF"
  gpgconf --kill gpg-agent
fi
