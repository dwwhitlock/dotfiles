# terraform
alias tf='terraform'
alias tg='terragrunt'
alias tgf='terragrunt hclfmt'
alias tfa='terraform apply'
alias tfd='terraform destroy'
alias tfp='terraform plan'
alias tfi='terraform init'
alias tfaa='tfa -auto-approve'
alias tfw='terraform workspace'
alias tfda='tfd -auto-approve'
alias rebirth="tfd -auto-approve && tfa --auto-approve"

alias aws_env='env | sort | grep AWS'
alias da="direnv allow"
alias de="direnv edit"
alias pcr="pre-commit run"
alias pcra="pre-commit run --all-files"

alias senv="env | sort"


#git
alias pull_and_merge='git checkout main && git pull && git checkout - && git merge main'
alias pull_and_rebase='git checkout main && git pull && git checkout - && git rebase main'


# claude
alias claude_auto='claude --permission-mode auto'